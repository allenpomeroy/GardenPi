[Unit]
# v2.4
# - --bind, --certfile and --keyfile are set on the command line below again.
#   Command-line values override bin/gunicorn.conf.py, so these -- not
#   garden.json -- decide the API's port and certificate. Keep them in step
#   with handlers.api.listen_port and config.tls_cert_file/_key_file (remove
#   an option to let gunicorn.conf.py take that value from garden.json).
# v2.3
# - removed Wants= on the handlers (see the note above After=).
# v2.2
# - listen port and TLS certificate/key read from garden.json by
#   bin/gunicorn.conf.py (superseded by v2.4).
# - User/Group are installed from garden.json by add-services.sh.
# v2.1
# Sequencing: the API is a socket CLIENT of every hardware handler (adc,
# irrigation, leds, and now weather too), so it must start after all four
# per restart-services.sh's mandatory order
# (leds -> adc -> irrigation -> weather -> api -> webui).
Description=GardenPi API
# No Wants= on the other GardenPi services: each one is enabled on its own,
# so all of them still start at boot (in this After= order), but starting
# or restarting this service doesn't pull a stopped/disabled one back up.
# That's what lets `sudo systemctl disable --now gardenpi-<name>` keep a
# service down for troubleshooting.
After=network.target gardenpi-adc.service gardenpi-irrigation.service gardenpi-leds.service gardenpi-weather.service

[Service]
Type=notify

# User/Group: add-services.sh replaces these with garden.json's
# config.application_user / config.application_group when installing.
User=pi
Group=pi
WorkingDirectory=/opt/gardenpi/bin
ExecStart=/opt/gardenpi/python3/bin/gunicorn \
    --bind 0.0.0.0:5000 \
    --workers 2 \
    --timeout 60 \
    --graceful-timeout 10 \
    --preload \
    --access-logfile - \
    --certfile /etc/pki/tls/certs/node.pem \
    --keyfile /etc/pki/tls/private/node.key \
    --error-logfile - \
    'api:create_app()'
Restart=on-failure
RestartSec=5
#WatchdogSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gardenpi-api


[Install]
WantedBy=multi-user.target
