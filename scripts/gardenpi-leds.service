[Unit]
# v2.0
Description=GardenPi LEDs
After=network.target gardenpi-init.service
Requires=gardenpi-init.service

[Service]
Type=simple
User=pi
Group=pi
ExecStart=/opt/gardenpi/bin/led-handler.py
ExecStop=/opt/gardenpi/bin/leds.py sysred on
Restart=on-failure
RestartSec=2
RuntimeDirectory=leds
WorkingDirectory=/opt/gardenpi/bin
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gardenpi-leds


[Install]
WantedBy=multi-user.target
