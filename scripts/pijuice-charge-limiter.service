[Unit]
Description=PiJuice LiPo charge limiter (hold battery around 45-50%)
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/gardenpi/bin/pijuice-charge-limiter.py --upper 50 --lower 45 --max-temp 40
Restart=always
RestartSec=15
User=pi
Group=pi

# Light hardening
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
